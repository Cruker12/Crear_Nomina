<Window x:Class="GeneradoNominaSystem.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeneradoNominaSystem.Presentation"
        xmlns:views="clr-namespace:GeneradoNominaSystem.Presentation.Views"
        mc:Ignorable="d"
        Title="{Binding Titulo}" Height="700" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Titulo}"
                   HorizontalAlignment="Center"
                   FontSize="22"
                   Margin="0,8" />

        <TabControl Grid.Row="1">
            <TabItem Header="Empresas">
                <views:EmpresaView x:Name="EmpresaView" />
            </TabItem>
            <TabItem Header="Empleados">
                <views:EmpleadoView x:Name="EmpleadoView" />
            </TabItem>
            <TabItem Header="Conceptos">
                <views:ConceptoView x:Name="ConceptoView" />
            </TabItem>
            <TabItem Header="Periodos">
                <views:PeriodoView x:Name="PeriodoView" />
            </TabItem>
            <TabItem Header="Nóminas">
                <views:NominaView x:Name="NominaView" />
            </TabItem>
            <TabItem Header="Plantillas">
                <views:PlantillaView x:Name="PlantillaView" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
