<UserControl x:Class="GeneradoNominaSystem.Presentation.Views.CotizacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Empresa" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding EmpresasLista}"
                      SelectedItem="{Binding EmpresaSeleccionada}"
                      DisplayMemberPath="NombreComercial"
                      Width="200" Margin="8,0,0,0" />
            <Button Content="Recargar" Command="{Binding RecargarCommand}" Margin="16,0,0,0" Padding="12,4" />
            <Button Content="Nueva" Command="{Binding NuevaCommand}" Margin="8,0,0,0" Padding="12,4" />
            <Button Content="Crear cotización" Command="{Binding CrearCommand}" Margin="8,0,0,0" Padding="12,4" />
            <TextBlock Text="Plantilla" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding PlantillasLista}"
                      SelectedItem="{Binding PlantillaSeleccionada}"
                      DisplayMemberPath="Nombre"
                      Width="160" Margin="8,0,0,0" />
            <Button Content="Asignar" Command="{Binding AsignarPlantillaCommand}" Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Cotizaciones" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel DataContext="{Binding Edicion}" Margin="0,0,0,8">
                        <TextBlock Text="Cliente" />
                        <TextBox Text="{Binding ClienteNombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="220" Margin="0,0,8,0">
                                <TextBlock Text="Vigencia" />
                                <DatePicker SelectedDate="{Binding FechaVigencia}" />
                            </StackPanel>
                            <StackPanel Width="*">
                                <TextBlock Text="Observaciones" />
                                <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CotizacionesLista}"
                              SelectedItem="{Binding Seleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding NumeroCotizacion}" Width="130" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalNeto, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Detalles de la seleccionada" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DetallesGrid"
                              ItemsSource="{Binding Seleccionada.Detalles}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitarioMonto, StringFormat=N2}" Width="100" />
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding ProductosLista}"
                                      SelectedItem="{Binding ProductoSeleccionado}"
                                      DisplayMemberPath="Nombre"
                                      Width="180" />
                            <TextBox Text="{Binding NuevaDescripcion, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Cant." VerticalAlignment="Center" />
                            <TextBox Text="{Binding NuevaCantidad, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,0,0" />
                            <TextBlock Text="Precio" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NuevoPrecio, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="8,0,0,0" />
                            <TextBlock Text="Dto.%" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NuevoDescuento, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0" />
                            <Button Content="Agregar" Command="{Binding AgregarDetalleCommand}" Margin="8,0,0,0" Padding="12,2" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Quitar seleccionado" Command="{Binding QuitarDetalleCommand}" CommandParameter="{Binding ElementName=DetallesGrid, Path=SelectedItem}" Padding="12,2" />
                            <Button Content="Enviar" Command="{Binding EnviarCommand}" Margin="8,0,0,0" Padding="12,2" />
                            <Button Content="Aceptar" Command="{Binding AceptarCommand}" Margin="8,0,0,0" Padding="12,2" />
                            <Button Content="PDF" Command="{Binding ExportarPdfCommand}" Margin="8,0,0,0" Padding="12,2" />
                            <Button Content="Excel" Command="{Binding ExportarExcelCommand}" Margin="8,0,0,0" Padding="12,2" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}" Width="100" Height="8" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource MensajeStyle}" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
