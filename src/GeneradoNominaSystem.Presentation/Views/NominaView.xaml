<UserControl x:Class="GeneradoNominaSystem.Presentation.Views.NominaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Empresa" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding EmpresasLista}"
                      SelectedItem="{Binding EmpresaSeleccionada}"
                      DisplayMemberPath="NombreComercial"
                      Width="200" Margin="8,0,0,0" />
            <TextBlock Text="Empleado" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding EmpleadosLista}"
                      SelectedItem="{Binding EmpleadoSeleccionado}"
                      DisplayMemberPath="Nombres"
                      Width="180" Margin="8,0,0,0" />
            <TextBlock Text="Periodo" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox ItemsSource="{Binding PeriodosLista}"
                      SelectedItem="{Binding PeriodoSeleccionado}"
                      DisplayMemberPath="Nombre"
                      Width="180" Margin="8,0,0,0" />
            <Button Content="Nueva nómina" Command="{Binding CrearCommand}" Margin="16,0,0,0" Padding="12,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Nóminas" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding NominasLista}"
                          SelectedItem="{Binding Seleccionada}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Empleado" Binding="{Binding EmpleadoNombre}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90" />
                        <DataGridTextColumn Header="Neto" Binding="{Binding TotalNeto}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Detalles de la seleccionada" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding Seleccionada.Detalles}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding ConceptoNombre}" Width="*" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding ValorMonto}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding ConceptosLista}"
                                      SelectedItem="{Binding ConceptoSeleccionado}"
                                      DisplayMemberPath="Nombre"
                                      Width="200" />
                            <TextBox Text="{Binding NuevoValor, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120" Margin="8,0,0,0" />
                            <Button Content="Agregar" Command="{Binding AgregarDetalleCommand}" Margin="8,0,0,0" Padding="12,2" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Base p. porcentajes" VerticalAlignment="Center" />
                            <TextBox Text="{Binding BaseMonto, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120" Margin="8,0,0,0" />
                            <Button Content="Calcular" Command="{Binding CalcularCommand}" Margin="8,0,0,0" Padding="12,2" />
                            <Button Content="Aprobar" Command="{Binding AprobarCommand}" Margin="8,0,0,0" Padding="12,2" />
                            <Button Content="Pagar" Command="{Binding PagarCommand}" Margin="8,0,0,0" Padding="12,2" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" />
                            <Button Content="Anular" Command="{Binding AnularCommand}" Margin="8,0,0,0" Padding="12,2" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Mensaje}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
