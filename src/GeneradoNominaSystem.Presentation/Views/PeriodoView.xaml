<UserControl x:Class="GeneradoNominaSystem.Presentation.Views.PeriodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Empresa" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding EmpresasLista}"
                      SelectedItem="{Binding EmpresaSeleccionada}"
                      DisplayMemberPath="NombreComercial"
                      Width="250" Margin="8,0,0,0" />
            <Button Content="Recargar" Command="{Binding RecargarCommand}" Margin="16,0,0,0" Padding="12,4" />
            <Button Content="Nuevo" Command="{Binding NuevoCommand}" Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding PeriodosLista}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0,0,8,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100" />
                    <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" DataContext="{Binding Edicion}">
                <TextBlock Text="Nombre (ej. Marzo 2026)" />
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <TextBlock Text="Tipo" />
                <ComboBox ItemsSource="{Binding DataContext.Tipos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Tipo}" Margin="0,0,0,6" />
                <TextBlock Text="Fecha inicio" />
                <DatePicker SelectedDate="{Binding FechaInicio}" Margin="0,0,0,6" />
                <TextBlock Text="Fecha fin" />
                <DatePicker SelectedDate="{Binding FechaFin}" Margin="0,0,0,6" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="16,4" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}" Width="100" Height="8" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource MensajeStyle}" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
